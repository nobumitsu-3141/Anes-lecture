{
  "abbr": [
    {
      "abbr": "SpO2",
      "full": "percutaneous oxygen saturation",
      "ja": "経皮的動脈血酸素飽和度"
    },
    {
      "abbr": "EtCO2",
      "full": "end-tidal CO2",
      "ja": "呼気終末二酸化炭素分圧"
    },
    {
      "abbr": "FiO2",
      "full": "fraction of inspired oxygen",
      "ja": "吸入酸素濃度"
    },
    {
      "abbr": "PEEP",
      "full": "positive end-expiratory pressure",
      "ja": "呼気終末陽圧"
    }
  ],
  "decks": {
    "8-1": [
      {
        "text": "酸素化は SpO2、換気は EtCO2 で別に見る。酸素投与中は低換気が隠れる",
        "ref": [
          1
        ]
      },
      {
        "text": "真のシャントは FiO2 を上げても治らない。無気肺やチューブ位置を直す",
        "ref": [
          3
        ]
      },
      {
        "text": "EtCO2 が急に下がり波形が消えたら回路・気道、残れば循環を疑う",
        "ref": [
          4
        ]
      },
      {
        "text": "SpO2 90% を切ると急峻部。少しの悪化で酸素含量が大きく落ちる",
        "ref": [
          9
        ]
      }
    ],
    "8-2": [
      {
        "text": "1 回換気量は予測体重で 6〜8 mL/kg。PEEP 5 cmH2O から始める",
        "ref": [
          1,
          2
        ]
      },
      {
        "text": "従量式は気道内圧の上限、従圧式は換気量の下限をアラームに設定する",
        "ref": [
          3
        ]
      },
      {
        "text": "換気装置に切り替えたら胸郭・カプノグラム・実測換気量・気道内圧の順に見る",
        "ref": [
          6
        ]
      },
      {
        "text": "片肺換気は 1 回換気量 4〜6 mL/kg 予測体重で始める",
        "ref": [
          7
        ]
      }
    ],
    "8-3": [
      {
        "text": "駆動圧はプラトー圧から PEEP を引く。15 cmH2O 以下、理想は 12 以下",
        "ref": [
          3
        ]
      },
      {
        "text": "PEEP は一律に上げない。上げて駆動圧が増えたら戻す",
        "ref": [
          3,
          4
        ]
      },
      {
        "text": "リクルートメントは全例に行わない。循環血液量を確かめ昇圧薬を手元に",
        "ref": [
          5
        ]
      },
      {
        "text": "目標 SpO2 は 92〜97%。低酸素がないのに 98% 以上を狙わない",
        "ref": [
          6
        ]
      }
    ]
  }
}
