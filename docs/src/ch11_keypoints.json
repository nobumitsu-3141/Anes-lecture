{
  "abbr": [
    {
      "abbr": "Hb",
      "full": "hemoglobin",
      "ja": "ヘモグロビン"
    },
    {
      "abbr": "PT",
      "full": "prothrombin time",
      "ja": "プロトロンビン時間"
    },
    {
      "abbr": "APTT",
      "full": "activated partial thromboplastin time",
      "ja": "活性化部分トロンボプラスチン時間"
    },
    {
      "abbr": "FFP",
      "full": "fresh frozen plasma",
      "ja": "新鮮凍結血漿"
    },
    {
      "abbr": "DOAC",
      "full": "direct oral anticoagulant",
      "ja": "直接経口抗凝固薬"
    },
    {
      "abbr": "PCC",
      "full": "prothrombin complex concentrate",
      "ja": "プロトロンビン複合体製剤"
    },
    {
      "abbr": "GVHD",
      "full": "graft-versus-host disease",
      "ja": "移植片対宿主病"
    },
    {
      "abbr": "TRALI",
      "full": "transfusion-related acute lung injury",
      "ja": "輸血関連急性肺障害"
    },
    {
      "abbr": "TACO",
      "full": "transfusion-associated circulatory overload",
      "ja": "輸血関連循環過負荷"
    }
  ],
  "decks": {
    "11-1": [
      {
        "text": "目視の出血量は当たらない。量って、洗浄液を引く",
        "ref": [
          2,
          3
        ]
      },
      {
        "text": "許容出血量は待つ量ではない。速い出血は値を待たず輸血と応援",
        "ref": [
          5
        ]
      },
      {
        "text": "安定した成人は Hb <7 g/dL が基本。活動性出血は到着時間から逆算",
        "ref": [
          6
        ]
      },
      {
        "text": "麻酔中は頻脈を待たない。脈圧と呼気二酸化炭素の傾向で読む",
        "ref": [
          7
        ]
      }
    ],
    "11-2": [
      {
        "text": "出血の予測はスクリーニング検査より出血歴の問診で",
        "ref": [
          1
        ]
      },
      {
        "text": "APTT だけの延長は、まずヘパリン混入を疑う",
        "ref": [
          3
        ]
      },
      {
        "text": "PT・APTT は 37℃ で測る。低体温と低カルシウムは映らない",
        "ref": [
          5
        ]
      },
      {
        "text": "血小板数が正常でも、抗血小板薬による機能低下は映らない",
        "ref": [
          4
        ]
      }
    ],
    "11-3": [
      {
        "text": "薬や製剤より外科的止血が先。搬送かダメージコントロールかを早く決める",
        "ref": [
          1
        ]
      },
      {
        "text": "重炭酸で凝固は戻らない。カルシウムは測りながら別ルートで補う",
        "ref": [
          4
        ]
      },
      {
        "text": "トラネキサム酸は外傷・分娩後出血に 3 時間以内。消化管出血には使わない",
        "ref": [
          5
        ]
      },
      {
        "text": "フィブリノゲンが最初に落ちる。FFP では上がりにくく、製剤かクリオで",
        "ref": [
          2,
          6
        ]
      }
    ],
    "11-4": [
      {
        "text": "DOAC は PT・APTT で量れない。最終服用時刻と腎機能を聞く",
        "ref": [
          1,
          3
        ]
      },
      {
        "text": "ワルファリンの重篤出血・緊急手術は FFP より PCC＋ビタミン K",
        "ref": [
          4
        ]
      },
      {
        "text": "心大血管手術の前にアンデキサネットを使わない。拮抗は PCC で",
        "ref": [
          5
        ]
      },
      {
        "text": "プロタミン 1 mg でヘパリン 100 単位を中和。急速静注しない",
        "ref": [
          6
        ]
      }
    ],
    "11-5": [
      {
        "text": "旧「使用指針」は 2026 年 3 月に廃止。数値は輸血療法実践ガイドで",
        "ref": [
          1
        ]
      },
      {
        "text": "海外の 1 単位は国内の約 2 単位。論文の数字は読み替える",
        "ref": [
          2
        ]
      },
      {
        "text": "FFP は凝固因子の補充用。容量補充や予防投与に使わない",
        "ref": [
          3
        ]
      },
      {
        "text": "輸血後 GVHD は照射で防ぐ。白血球除去では防げない",
        "ref": [
          7
        ]
      }
    ],
    "11-6": [
      {
        "text": "不適合輸血の主因は照合間違い。2 人で声に出して照合する",
        "ref": [
          1,
          3
        ]
      },
      {
        "text": "血液型は別の時点で採った 2 検体で確定する",
        "ref": [
          2
        ]
      },
      {
        "text": "開始後 5 分は離れない。疑えば止めて輸血セットごと交換",
        "ref": [
          4
        ]
      },
      {
        "text": "O 型を入れる前に検体を採る。緊急の血漿・血小板は AB 型",
        "ref": [
          7
        ]
      }
    ],
    "11-7": [
      {
        "text": "麻酔中の原因不明の低血圧は、まず輸血を止めて尿の色を見る",
        "ref": [
          1,
          3
        ]
      },
      {
        "text": "副作用を疑ったらバッグとセットを捨てず返し、検体を確保する",
        "ref": [
          2
        ]
      },
      {
        "text": "TRALI は利尿薬を避け、TACO は利尿薬。まず鑑別する",
        "ref": [
          5
        ]
      },
      {
        "text": "保存赤血球の中心静脈からの急速投与は高カリウム心停止を起こしうる",
        "ref": [
          6
        ]
      }
    ],
    "11-8": [
      {
        "text": "迷ったら宣言。コマンダーを決め、空振りを許す",
        "ref": [
          2
        ]
      },
      {
        "text": "危機的出血では交差適合試験を待たない。異型適合血もためらわない",
        "ref": [
          4
        ]
      },
      {
        "text": "循環血液量を超える出血が見込まれたら、検査を待たず FFP を融解",
        "ref": [
          5
        ]
      },
      {
        "text": "止血まで収縮期 80〜90 mmHg。重症頭部外傷では平均血圧を高く",
        "ref": [
          7
        ]
      }
    ],
    "11-9": [
      {
        "text": "到着までの時間・型別の在庫・夜間の検査体制を数字で把握する",
        "ref": [
          1
        ]
      },
      {
        "text": "O 型を使った時点で補充を発注。FFP は赤血球と同時に融解",
        "ref": [
          5
        ]
      },
      {
        "text": "搬送の判断は夕方を待たない。ドクターヘリは日中・好天のみ",
        "ref": [
          4
        ]
      },
      {
        "text": "在庫と到着時間で賄えない予定手術・血小板が要りそうな手術は本土へ",
        "ref": [
          7
        ]
      }
    ]
  }
}
